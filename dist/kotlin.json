  "constraints": {
    "hard": [
      {
        "statement": "No `!!` without justification",
        "rationale": "Use safe calls, elvis, or explicit null checks"
      },
      {
        "statement": "No GlobalScope",
        "rationale": "Use structured concurrency with viewModelScope, lifecycleScope, or custom scopes"
      },
      {
        "statement": "No blocking on main thread",
        "rationale": "Use withContext(Dispatchers.IO) for I/O operations"
      },
      {
        "statement": "Proper state hoisting",
        "rationale": "State should flow down, events should flow up"
      },
      {
        "statement": "No mutable state in Composables",
        "rationale": "Use remember with mutableStateOf, not var"
      },
      {
        "statement": "No Java static patterns",
        "rationale": "Use companion object, top-level functions, or object declarations"
      },
      {
        "statement": "No builder pattern when DSL works",
        "rationale": "Use Kotlin DSL patterns instead"
      },
      {
        "statement": "Lifecycle awareness",
        "rationale": "Collect flows in lifecycle-aware manner"
      },
      {
        "statement": "No hardcoded strings",
        "rationale": "Use string resources for user-visible text"
      },
      {
        "statement": "Testable design",
        "rationale": "Dependencies injectable, avoid singletons"
      }
    ],
    "soft": [
      {
        "statement": "Prefer StateFlow over LiveData in new code",
        "rationale": null
      },
      {
        "statement": "Prefer sealed classes/interfaces over enums for complex states",
        "rationale": null
      },
      {
        "statement": "Prefer Kotlin stdlib over Java equivalents",
        "rationale": "listOf vs Arrays.asList"
      },
      {
        "statement": "Prefer extension functions over utility classes",
        "rationale": null
      },
      {
        "statement": "Prefer immutable data classes",
        "rationale": null
      },
      {
        "statement": "Prefer explicit typing in public APIs",
        "rationale": null
      },
      {
        "statement": "Prefer by lazy for expensive initializations",
        "rationale": null
      },
      {
        "statement": "Prefer compatible Kotlin/Compose/AGP version combinations",
        "rationale": null
      },
      {
        "statement": "Prefer offline-first with sync over online-only patterns",
        "rationale": null
      },
      {
        "statement": "Prefer Material 3 over Material 2 in new projects",
        "rationale": null
      }
    ]
  },
