  "constraints": {
    "hard": [
      {
        "statement": "No unbounded allocations",
        "rationale": "Avoid malloc in loops, prefer static allocation or memory pools"
      },
      {
        "statement": "Check all allocations",
        "rationale": "Always verify malloc/new returns, handle failure gracefully"
      },
      {
        "statement": "No undefined behavior",
        "rationale": "Avoid strict aliasing violations, uninitialized reads, signed overflow"
      },
      {
        "statement": "Proper ISR handling",
        "rationale": "No blocking calls, no printf, minimal work in interrupt context"
      },
      {
        "statement": "Resource cleanup",
        "rationale": "RAII in C++, explicit cleanup in C, no resource leaks"
      },
      {
        "statement": "Bounds checking",
        "rationale": "Validate array indices, buffer sizes, string lengths"
      },
      {
        "statement": "Volatile correctness",
        "rationale": "Use volatile for hardware registers and ISR-shared variables"
      },
      {
        "statement": "Stack size awareness",
        "rationale": "Warn about deep recursion, large stack allocations"
      },
      {
        "statement": "Thread safety",
        "rationale": "Identify shared state, use appropriate synchronization"
      },
      {
        "statement": "No magic numbers",
        "rationale": "Use named constants, enums, or #defines for hardware addresses"
      }
    ],
    "soft": [
      {
        "statement": "Prefer static allocation over dynamic in embedded contexts",
        "rationale": null
      },
      {
        "statement": "Prefer composition over deep inheritance hierarchies",
        "rationale": null
      },
      {
        "statement": "Prefer explicit over implicit",
        "rationale": "constructors, conversions"
      },
      {
        "statement": "Avoid exceptions in embedded",
        "rationale": "unless project enables them"
      },
      {
        "statement": "Prefer fixed-width types (uint32_t) over platform-dependent",
        "rationale": "int"
      },
      {
        "statement": "Avoid complex templates that bloat code size",
        "rationale": null
      },
      {
        "statement": "Prefer polling over interrupts for simple cases",
        "rationale": "easier debugging"
      }
    ]
  },
